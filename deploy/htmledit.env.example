# htmledit の環境変数設定ファイル
# /etc/htmledit/htmledit.env にコピーして使う。

# --- 待ち受け ---
# 既定は 127.0.0.1 (tailscale serve 経由でのみ公開する)。
# LAN からも直接アクセスしたい場合は 0.0.0.0 に変更する。
HTMLEDIT_HOST=127.0.0.1
HTMLEDIT_PORT=3372

# --- データ保存先 (サイト登録情報と clone したリポジトリ) ---
HTMLEDIT_DATA_DIR=/opt/htmledit/data

# --- メモ (ファイルエクスプローラー) の保存先 ---
HTMLEDIT_MEMO_DIR=/opt/lxd-data/htmledit-memo
# 既定のメモファイル (未設定なら $HTMLEDIT_MEMO_DIR/memo.md)
#HTMLEDIT_MEMO_FILE=/opt/lxd-data/htmledit-memo/memo.md

# --- GitHub 連携 ---
# push / pull 用の Personal Access Token (repo スコープ)。
# 未設定の場合は SSH 鍵を使った接続になる。
GITHUB_TOKEN=


# --- -basic 認証 (公開する場合は必ず設定する) ---
HTMLEDIT_AUTH_USER=
HTMLEDIT_AUTH_PASSWORD=

# --- コミット時に使う作者情報 ---
HTMLEDIT_COMMIT_USER_NAME=htmledit
HTMLEDIT_COMMIT_USER_EMAIL=htmledit@localhost

# --- アップデート時に参照する htmledit 自身のリポジトリ ---
HTMLEDIT_REPO_URL=https://github.com/hirogura/htmledit.git

# --- 再起動時に操作する systemd ユニット名 ---
HTMLEDIT_SERVICE_NAME=htmledit
