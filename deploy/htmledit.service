[Unit]
Description=htmledit - GitHub 上の静的サイトを WYSIWYG で編集する Web エディター
Documentation=https://github.com/hirogura/htmledit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/htmledit
EnvironmentFile=-/etc/htmledit/htmledit.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/htmledit
ExecStart=/usr/bin/python3 -m htmledit
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

# セキュリティ設定 (必要に応じて緩めても動作する)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/opt/htmledit/data /opt/htmledit/.git /opt/htmledit/static

[Install]
WantedBy=multi-user.target
